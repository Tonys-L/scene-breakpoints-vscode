{
  "name": "scene-breakpoints-vscode",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "1.0.3",
  "publisher": "tony-l",
  "author": "Tony.L <286269159@qq.com>",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tonys-L/scene-breakpoints-vscode"
  },
  "bugs": {
    "url": "https://github.com/Tonys-L/scene-breakpoints-vscode/issues"
  },
  "homepage": "https://github.com/Tonys-L/scene-breakpoints-vscode#readme",
  "keywords": [
    "breakpoints",
    "breakpoint",
    "breakpoint-manager",
    "breakpoint-healing",
    "debug",
    "debugging",
    "scene",
    "scenario",
    "ai-agent",
    "agent-skill",
    "code-tour",
    "workflow"
  ],
  "l10n": "./l10n",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Debuggers",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "%extension.displayName%",
      "properties": {
        "sceneBreakpoints.autoActivateOnLaunch": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoActivateOnLaunch%"
        },
        "sceneBreakpoints.allowAiFileActivation": {
          "type": "boolean",
          "default": false,
          "description": "%config.allowAiFileActivation%"
        },
        "sceneBreakpoints.autoInstallSkill": {
          "type": "boolean",
          "default": false,
          "description": "%config.autoInstallSkill%"
        }
      }
    },
    "commands": [
      {
        "command": "sceneBreakpoints.diagnoseAiIntegration",
        "title": "%command.diagnoseAiIntegration%",
        "icon": "$(pulse)",
        "category": "Scene"
      },
      {
        "command": "sceneBreakpoints.installSkill",
        "title": "%command.installSkill%",
        "icon": "$(hubot)",
        "category": "Scene"
      },
      {
        "command": "sceneBreakpoints.addBreakpoint",
        "title": "%command.addBreakpoint%",
        "category": "Scene"
      },
      {
        "command": "sceneBreakpoints.applyScene",
        "title": "%command.applyScene%",
        "icon": "$(debug-start)",
        "category": "Scene"
      },
      {
        "command": "sceneBreakpoints.clearAll",
        "title": "%command.clearAll%",
        "category": "Scene"
      },
      {
        "command": "sceneBreakpoints.exportScene",
        "title": "%command.exportScene%",
        "icon": "$(export)",
        "category": "Scene"
      },
      {
        "command": "sceneBreakpoints.showMenu",
        "title": "%command.showMenu%",
        "category": "Scene"
      },
      {
        "command": "sceneBreakpoints.refreshView",
        "title": "%command.refreshView%",
        "icon": "$(refresh)",
        "category": "Scene"
      },
      {
        "command": "sceneBreakpoints.createNewScene",
        "title": "%command.createNewScene%",
        "icon": "$(add)",
        "category": "Scene"
      },
      {
        "command": "sceneBreakpoints.applySceneItem",
        "title": "%command.applySceneItem%",
        "icon": "$(play)",
        "category": "Scene"
      },
      {
        "command": "sceneBreakpoints.renameSceneItem",
        "title": "%command.renameSceneItem%",
        "icon": "$(edit)",
        "category": "Scene"
      },
      {
        "command": "sceneBreakpoints.deleteSceneItem",
        "title": "%command.deleteSceneItem%",
        "icon": "$(trash)",
        "category": "Scene"
      },
      {
        "command": "sceneBreakpoints.removeBreakpointItem",
        "title": "%command.removeBreakpointItem%",
        "icon": "$(trash)",
        "category": "Scene"
      },
      {
        "command": "sceneBreakpoints.toggleBreakpointItem",
        "title": "%command.toggleBreakpointItem%",
        "icon": "$(eye)",
        "category": "Scene"
      },
      {
        "command": "sceneBreakpoints.copySceneToClipboard",
        "title": "%command.copySceneToClipboard%",
        "icon": "$(clippy)",
        "category": "Scene"
      },
      {
        "command": "sceneBreakpoints.importSceneFromClipboard",
        "title": "%command.importSceneFromClipboard%",
        "icon": "$(cloud-download)",
        "category": "Scene"
      },
      {
        "command": "sceneBreakpoints.toggleSceneActivation",
        "title": "%command.toggleSceneActivation%",
        "icon": "$(check)",
        "category": "Scene"
      },
      {
        "command": "sceneBreakpoints.enableAllBreakpointsInScene",
        "title": "%command.enableAllBreakpointsInScene%",
        "icon": "$(check-all)",
        "category": "Scene"
      },
      {
        "command": "sceneBreakpoints.disableAllBreakpointsInScene",
        "title": "%command.disableAllBreakpointsInScene%",
        "icon": "$(clear-all)",
        "category": "Scene"
      },
      {
        "command": "sceneBreakpoints.duplicateScene",
        "title": "%command.duplicateScene%",
        "icon": "$(files)",
        "category": "Scene"
      },
      {
        "command": "sceneBreakpoints.revealInConfigFile",
        "title": "%command.revealInConfigFile%",
        "icon": "$(go-to-file)",
        "category": "Scene"
      },
      {
        "command": "sceneBreakpoints.moveBreakpointUp",
        "title": "%command.moveBreakpointUp%",
        "icon": "$(arrow-up)",
        "category": "Scene"
      },
      {
        "command": "sceneBreakpoints.moveBreakpointDown",
        "title": "%command.moveBreakpointDown%",
        "icon": "$(arrow-down)",
        "category": "Scene"
      }
    ],
    "views": {
      "debug": [
        {
          "id": "sceneBreakpointsView",
          "name": "%view.sceneBreakpoints%",
          "contextualTitle": "Scene Breakpoints"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "sceneBreakpoints.refreshView",
          "when": "false"
        },
        {
          "command": "sceneBreakpoints.createNewScene",
          "when": "false"
        },
        {
          "command": "sceneBreakpoints.applySceneItem",
          "when": "false"
        },
        {
          "command": "sceneBreakpoints.toggleSceneActivation",
          "when": "false"
        },
        {
          "command": "sceneBreakpoints.renameSceneItem",
          "when": "false"
        },
        {
          "command": "sceneBreakpoints.deleteSceneItem",
          "when": "false"
        },
        {
          "command": "sceneBreakpoints.removeBreakpointItem",
          "when": "false"
        },
        {
          "command": "sceneBreakpoints.toggleBreakpointItem",
          "when": "false"
        },
        {
          "command": "sceneBreakpoints.enableAllBreakpointsInScene",
          "when": "false"
        },
        {
          "command": "sceneBreakpoints.disableAllBreakpointsInScene",
          "when": "false"
        },
        {
          "command": "sceneBreakpoints.duplicateScene",
          "when": "false"
        },
        {
          "command": "sceneBreakpoints.revealInConfigFile",
          "when": "false"
        },
        {
          "command": "sceneBreakpoints.moveBreakpointUp",
          "when": "false"
        },
        {
          "command": "sceneBreakpoints.moveBreakpointDown",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "sceneBreakpoints.applyScene",
          "when": "view == sceneBreakpointsView",
          "group": "navigation@1"
        },
        {
          "command": "sceneBreakpoints.createNewScene",
          "when": "view == sceneBreakpointsView",
          "group": "navigation@2"
        },
        {
          "command": "sceneBreakpoints.exportScene",
          "when": "view == sceneBreakpointsView",
          "group": "navigation@3"
        },
        {
          "command": "sceneBreakpoints.importSceneFromClipboard",
          "when": "view == sceneBreakpointsView",
          "group": "navigation@4"
        },
        {
          "command": "sceneBreakpoints.diagnoseAiIntegration",
          "when": "view == sceneBreakpointsView",
          "group": "navigation@5"
        },
        {
          "command": "sceneBreakpoints.refreshView",
          "when": "view == sceneBreakpointsView",
          "group": "navigation@6"
        }
      ],
      "view/item/context": [
        {
          "command": "sceneBreakpoints.applySceneItem",
          "when": "view == sceneBreakpointsView && viewItem == sceneItem",
          "group": "inline@1"
        },
        {
          "command": "sceneBreakpoints.toggleSceneActivation",
          "when": "view == sceneBreakpointsView && viewItem == activeSceneItem",
          "group": "inline@1"
        },
        {
          "command": "sceneBreakpoints.copySceneToClipboard",
          "when": "view == sceneBreakpointsView && (viewItem == sceneItem || viewItem == activeSceneItem)",
          "group": "inline@2"
        },
        {
          "command": "sceneBreakpoints.renameSceneItem",
          "when": "view == sceneBreakpointsView && (viewItem == sceneItem || viewItem == activeSceneItem)",
          "group": "inline@3"
        },
        {
          "command": "sceneBreakpoints.deleteSceneItem",
          "when": "view == sceneBreakpointsView && (viewItem == sceneItem || viewItem == activeSceneItem)",
          "group": "inline@4"
        },
        {
          "command": "sceneBreakpoints.enableAllBreakpointsInScene",
          "when": "view == sceneBreakpointsView && (viewItem == sceneItem || viewItem == activeSceneItem)",
          "group": "2_sceneActions@1"
        },
        {
          "command": "sceneBreakpoints.disableAllBreakpointsInScene",
          "when": "view == sceneBreakpointsView && (viewItem == sceneItem || viewItem == activeSceneItem)",
          "group": "2_sceneActions@2"
        },
        {
          "command": "sceneBreakpoints.duplicateScene",
          "when": "view == sceneBreakpointsView && (viewItem == sceneItem || viewItem == activeSceneItem)",
          "group": "2_sceneActions@3"
        },
        {
          "command": "sceneBreakpoints.revealInConfigFile",
          "when": "view == sceneBreakpointsView && (viewItem == breakpointItemEnabled || viewItem == breakpointItemDisabled)",
          "group": "inline@1"
        },
        {
          "command": "sceneBreakpoints.moveBreakpointUp",
          "when": "view == sceneBreakpointsView && (viewItem == breakpointItemEnabled || viewItem == breakpointItemDisabled)",
          "group": "inline@2"
        },
        {
          "command": "sceneBreakpoints.moveBreakpointDown",
          "when": "view == sceneBreakpointsView && (viewItem == breakpointItemEnabled || viewItem == breakpointItemDisabled)",
          "group": "inline@3"
        },
        {
          "command": "sceneBreakpoints.removeBreakpointItem",
          "when": "view == sceneBreakpointsView && (viewItem == breakpointItemEnabled || viewItem == breakpointItemDisabled)",
          "group": "inline@4"
        },
        {
          "command": "sceneBreakpoints.revealInConfigFile",
          "when": "view == sceneBreakpointsView && (viewItem == breakpointItemEnabled || viewItem == breakpointItemDisabled)",
          "group": "1_actions@1"
        },
        {
          "command": "sceneBreakpoints.moveBreakpointUp",
          "when": "view == sceneBreakpointsView && (viewItem == breakpointItemEnabled || viewItem == breakpointItemDisabled)",
          "group": "1_actions@2"
        },
        {
          "command": "sceneBreakpoints.moveBreakpointDown",
          "when": "view == sceneBreakpointsView && (viewItem == breakpointItemEnabled || viewItem == breakpointItemDisabled)",
          "group": "1_actions@3"
        },
        {
          "command": "sceneBreakpoints.removeBreakpointItem",
          "when": "view == sceneBreakpointsView && (viewItem == breakpointItemEnabled || viewItem == breakpointItemDisabled)",
          "group": "1_actions@4"
        }
      ],
      "editor/context": [
        {
          "command": "sceneBreakpoints.addBreakpoint",
          "group": "debug@1",
          "when": "editorTextFocus"
        },
        {
          "command": "sceneBreakpoints.applyScene",
          "group": "debug@2",
          "when": "editorTextFocus"
        },
        {
          "command": "sceneBreakpoints.showMenu",
          "group": "debug@3",
          "when": "editorTextFocus"
        },
        {
          "command": "sceneBreakpoints.clearAll",
          "group": "debug@4",
          "when": "editorTextFocus"
        }
      ]
    },
    "keybindings": [
      {
        "command": "sceneBreakpoints.addBreakpoint",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b",
        "when": "editorTextFocus"
      },
      {
        "command": "sceneBreakpoints.showMenu",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": ".vscode/debug-scenes.json",
        "url": "./schema.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node build.mjs",
    "build:test": "node -e \"fs.rmSync('out-test', {recursive:true, force:true})\" && npx esbuild test-e2e/index.ts test-e2e/suite/*.test.ts --bundle --outdir=out-test --format=cjs --platform=node --external:vscode --external:mocha",
    "test": "node test/run-all.mjs",
    "test:unit": "node test/run-all.mjs",
    "test:e2e": "npm run build && npm run build:test && node test-e2e/runTest.mjs",
    "package": "npx -y @vscode/vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.2",
    "@vscode/test-electron": "^3.1.0",
    "mocha": "^12.0.1"
  }
}
