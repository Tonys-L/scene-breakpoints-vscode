{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "types": ["node", "vscode", "mocha"],
    "paths": {
      "#src/*": ["./src/*"],
      "#test/*": ["./test/*"],
      "#scripts/*": ["./scripts/*"]
    },
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["src/**/*", "test/**/*", "test-e2e/**/*"]
}
